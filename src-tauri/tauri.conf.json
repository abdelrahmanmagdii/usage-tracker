{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "UsageBar",
  "version": "0.1.0",
  "identifier": "com.usagebar.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "UsageBar",
        "width": 388,
        "height": 560,
        "minWidth": 388,
        "minHeight": 520,
        "maxWidth": 388,
        "maxHeight": 720,
        "resizable": false,
        "minimizable": true,
        "closable": true,
        "maximizable": false,
        "fullscreen": false,
        "visible": false,
        "decorations": true,
        "titleBarStyle": "Transparent",
        "hiddenTitle": true,
        "transparent": true,
        "alwaysOnTop": false,
        "skipTaskbar": false,
        "shadow": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  }
}
